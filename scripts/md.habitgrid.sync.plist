<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>md.habitgrid.sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <!-- Change both paths below -->
    <string>/Users/YOUR_NAME/habit-grid-sync/habit-log-sync.sh</string>
    <string>/Users/YOUR_NAME/path/to/your/vault</string>
  </array>
  <!-- Run when you log in, then every 30 minutes -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>StandardErrorPath</key>
  <string>/tmp/habit-grid-sync.log</string>
  <key>StandardOutPath</key>
  <string>/tmp/habit-grid-sync.log</string>
</dict>
</plist>
